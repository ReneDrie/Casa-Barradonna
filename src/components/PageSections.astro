---
import type { Locale, Section } from '../lib/types';
import BookingForm from './BookingForm.astro';
import HeroBlock from './blocks/HeroBlock.astro';
import FactsBlock from './blocks/FactsBlock.astro';
import IntroBlock from './blocks/IntroBlock.astro';
import ImageTextBlock from './blocks/ImageTextBlock.astro';
import FeatureGridBlock from './blocks/FeatureGridBlock.astro';
import GalleryBlock from './blocks/GalleryBlock.astro';
import FloorPlanBlock from './blocks/FloorPlanBlock.astro';
import QuoteBlock from './blocks/QuoteBlock.astro';
import FaqBlock from './blocks/FaqBlock.astro';
import CalloutBlock from './blocks/CalloutBlock.astro';

interface Props { sections: Section[]; locale: Locale; pageKey: string }
const { sections, locale, pageKey } = Astro.props;
const illustrationLabel = locale === 'en' ? 'Illustrative artwork' : 'Sfeerillustratie';
---
{sections.map((section) => (
  section._type === 'hero' ? <HeroBlock section={section} isHome={pageKey === 'home'} illustrationLabel={illustrationLabel} /> :
  section._type === 'facts' ? <FactsBlock section={section} locale={locale} /> :
  section._type === 'intro' ? <IntroBlock section={section} /> :
  section._type === 'imageText' ? <ImageTextBlock section={section} illustrationLabel={illustrationLabel} /> :
  section._type === 'featureGrid' ? <FeatureGridBlock section={section} /> :
  section._type === 'gallery' ? <GalleryBlock section={section} /> :
  section._type === 'floorPlan' ? <FloorPlanBlock section={section} locale={locale} /> :
  section._type === 'quote' ? <QuoteBlock section={section} /> :
  section._type === 'faq' ? <FaqBlock section={section} /> :
  section._type === 'callout' ? <CalloutBlock section={section} /> :
  section._type === 'bookingForm' ? <BookingForm locale={locale} eyebrow={section.eyebrow} heading={section.heading} text={section.text} /> : null
))}
