# Public Sanity project ID. The site uses local seed pages until CMS pages are published.
PUBLIC_SANITY_PROJECT_ID=b5rbq1la
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-01-01

# Use the real production domain before deployment.
PUBLIC_SITE_URL=https://casabarradonna.example
PUBLIC_SITE_LIVE=false

# Booking requests stay in preview mode until all delivery values are configured.
PUBLIC_BOOKING_REQUESTS_ENABLED=false
PUBLIC_FIRST_REQUEST_DATE=2027-04-01
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=
BOOKING_REQUESTS_ENABLED=false
AIRBNB_ICAL_URL=

# Sanity Studio uses a project ID, not a secret editing key. Sign-in is through Sanity.
SANITY_STUDIO_PROJECT_ID=b5rbq1la
SANITY_STUDIO_DATASET=production
